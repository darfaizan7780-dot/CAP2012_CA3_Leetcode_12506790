class MyLinkedList {
private:
    struct Node {
        int val;
        Node* next;

        Node(int value) {
            val = value;
            next = nullptr;
        }
    };

    Node* head;
    int length;

public:
    MyLinkedList() {
        head = nullptr;
        length = 0;
    }

    int get(int index) {
        if (index < 0 || index >= length) {
            return -1;
        }

        Node* current = head;

        for (int i = 0; i < index; i++) {
            current = current->next;
        }

        return current->val;
    }

    void addAtHead(int val) {
        Node* newNode = new Node(val);

        newNode->next = head;
        head = newNode;

        length++;
    }

    void addAtTail(int val) {
        Node* newNode = new Node(val);

        if (head == nullptr) {
            head = newNode;
        }
        else {
            Node* current = head;

            while (current->next != nullptr) {
                current = current->next;
            }

            current->next = newNode;
        }

        length++;
    }

    void addAtIndex(int index, int val) {
        if (index < 0 || index > length) {
            return;
        }

        if (index == 0) {
            addAtHead(val);
            return;
        }

        Node* current = head;

        for (int i = 0; i < index - 1; i++) {
            current = current->next;
        }

        Node* newNode = new Node(val);

        newNode->next = current->next;
        current->next = newNode;

        length++;
    }

    void deleteAtIndex(int index) {
        if (index < 0 || index >= length) {
            return;
        }

        Node* temp;

        if (index == 0) {
            temp = head;
            head = head->next;
        }
        else {
            Node* current = head;

            for (int i = 0; i < index - 1; i++) {
                current = current->next;
            }

            temp = current->next;
            current->next = temp->next;
        }

        delete temp;
        length--;
    }
};
